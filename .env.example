# Shopify Partner API
SHOPIFY_PARTNER_TOKEN=           # From partners.shopify.com → Settings → Partner API
SHOPIFY_PARTNER_ORG_ID=4257387
SHOPIFY_APP_ID=285758324737

# Buffer API
BUFFER_ACCESS_TOKEN=             # From buffer.com/developers/apps → your app → token
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Social platform channel IDs (filled after connecting channels to Buffer)
BUFFER_CHANNEL_TWITTER=
BUFFER_CHANNEL_LINKEDIN=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_FACEBOOK=
BUFFER_CHANNEL_THREADS=
BUFFER_CHANNEL_BLUESKY=

# Promo sub-account channel IDs (promotional handles)
BUFFER_CHANNEL_TWITTER_PROMO=
BUFFER_CHANNEL_LINKEDIN_PROMO=

# Wave thresholds
WAVE_1_INSTALL_THRESHOLD=15      # Installs needed to exit Wave 0 → Wave 1
WAVE_2_INSTALL_THRESHOLD=50      # Wave 1 → Wave 2
WAVE_3_INSTALL_THRESHOLD=100     # Wave 2 → Wave 3
VELOCITY_WINDOW_DAYS=7           # Rolling window for velocity calculation

# Notification
OPENCLAW_NOTIFY_CHANNEL=         # Optional: channel to notify on wave advance
